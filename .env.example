# =============================================================================
# CrymadX Mobile App — environment template.
#
# Copy this file to `.env` and fill in real values for local development.
# In production (Railway), set these in the service's environment variables
# tab — DO NOT commit real values to the repo.
# =============================================================================

# ── Backend integration ─────────────────────────────────────────────────────
# When VITE_USE_MOCK=true the app uses an in-process mock layer (offline,
# no backend needed). Set false to hit the real API.
VITE_USE_MOCK=false

# Real backend base URL (no trailing slash). Production points at the live
# api-gateway on Hetzner. Override locally if needed.
VITE_API_BASE_URL=https://backend.crymadx.io/api

# ── Cloudflare Turnstile (captcha) ──────────────────────────────────────────
# Public site key — safe to commit / expose. Production key is locked to
# crymadx.io domains; for `localhost` dev create `.env.development` and use
# the Cloudflare test key `1x00000000000000000000AA` instead.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACxSkJnebUGCt21E

# ── Web Push (browser notifications) ────────────────────────────────────────
# Public VAPID key. The matching private key lives on the notification-service
# backend env — NEVER put it here.
VITE_WEB_PUSH_PUBLIC_KEY=BI35vDyWLXfJuZ_GTuVjYcXEdtaJCVGrZKnjU_-ZMlG66bMvNw0_HDBA8ihI_3nfEmbEURwGK-AdtuoAZHFUcmc

# ── Google sign-in ──────────────────────────────────────────────────────────
# Google OAuth 2.0 Web Application Client ID — public, safe to commit.
# The matching client SECRET is NEVER stored here; it is only needed on the
# backend if it does a server-side token exchange (we don't — we verify the
# user's access token against Google's tokeninfo endpoint instead).
# Authorized origins must include this domain in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=33615649710-clh4ft6m6gld6fqh7lc19e3gasaijhda.apps.googleusercontent.com

# ── Server port (Railway sets PORT automatically) ───────────────────────────
# When running `npm run start` locally without PORT set, defaults to 3000.
# PORT=3000
